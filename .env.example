# ==========================================
# TrustGraph AI Root Environment Variables Example
# Copy to .env and set your production values
# ==========================================

# Backend Settings (Render)
DATABASE_URL=postgresql://user:password@hostname:5432/trustgraph
SECRET_KEY=generate_a_random_secure_production_secret_key_here
FRONTEND_URL=https://trustgraph-ai.vercel.app
BACKEND_CORS_ORIGINS=https://trustgraph-ai.vercel.app

# Frontend Settings (Vercel)
VITE_API_URL=https://trustgraph-backend.onrender.com/api/v1
VITE_WS_URL=wss://trustgraph-backend.onrender.com/ws

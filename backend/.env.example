# Backend Environment Variables Example for Render / Docker
# Copy to .env or set in Render Dashboard

DATABASE_URL=postgresql://user:password@hostname:5432/dbname
SECRET_KEY=change_this_to_a_secure_random_string_in_production
FRONTEND_URL=https://trustgraph-ai.vercel.app
BACKEND_CORS_ORIGINS=https://trustgraph-ai.vercel.app
